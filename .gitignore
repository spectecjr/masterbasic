# Python bytecode from the tools in tools/.
__pycache__/
*.py[cod]

# pyz80 leftovers.  tools/build.sh assembles into a temporary directory
# and cleans up after itself, so these should never appear -- but they do
# if you run pyz80 by hand to look at something.  Scoped to the root so
# that the source images in diskimages/ are not caught by the .dsk rule.
/*.dsk
/*.out
/*.lst
/*.map
/*.sym
/*.bin

# Ghidra's lock and scratch files, should a project be opened here again.
# The project that used to live in ghidra/ has been removed: the listings
# in disasm/ are the analysis now, and they can be checked by assembling.
ghidra/*.lock
ghidra/*.lock~
ghidra/**/*.ulock

# Editors and operating systems
.DS_Store
Thumbs.db
*.swp
*~

# VSCode project settings (not used; we put them in the workspace)

.vscode/
